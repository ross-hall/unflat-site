# Copy to .env for `netlify dev`, and add the same names in Netlify → Site configuration → Environment variables.
# Never commit the real values.

# Stripe → Developers → API keys. Use sk_test_… until you go live.
STRIPE_SECRET_KEY=sk_test_xxx
# Stripe → Developers → Webhooks → your endpoint → Signing secret. `stripe listen` prints a different one for local testing.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Price IDs (price_…) from the two products in Stripe's product catalogue. Test and live mode have different IDs.
# After a price change, list the new ID first and keep the old one: price_new,price_old
PRICE_ID_PERSONAL=price_xxx
PRICE_ID_STUDIO=price_xxx

# From `npm run keys`. The matching LICENCE_PUBLIC_KEY goes in the plugin, not here.
LICENCE_PRIVATE_KEY=xxx

# Resend → API keys. The sending domain must be verified in Resend.
RESEND_API_KEY=re_xxx
# Optional. Defaults to "Unflat <SUPPORT_EMAIL>".
EMAIL_FROM=Unflat <licences@unflat.app>

SUPPORT_EMAIL=hello@unflat.app

# Where this Netlify site lives: the checkout subdomain. The thank-you page is served from here.
DOMAIN=https://buy.unflat.app
# The main website, built in Framer. Stripe's back link and "Back to pricing" go here.
SITE_URL=https://unflat.app
